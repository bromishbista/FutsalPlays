# Copy this file to .env and fill in your own values. Never commit .env.
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True

# Gmail address and app password used for password reset emails
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Google Cloud API key (Geolocation API)
GOOGLE_MAPS_API_KEY=

# Khalti payment gateway keys (use test keys from the Khalti merchant dashboard)
KHALTI_PUBLIC_KEY=
KHALTI_SECRET_KEY=
